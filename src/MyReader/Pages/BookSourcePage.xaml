<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyReader.Pages.BookSourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid
            Grid.Row="0"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="网络书源"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Content="从社区仓库导入"
                    Click="ImportFromCommunity_Click"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Content="从 URL 导入"
                    Click="ImportFromUrl_Click" />
                <Button
                    Content="从文件导入"
                    Click="ImportFromFile_Click" />
                <Button
                    Content="测试搜索"
                    Click="TestSearch_Click" />
            </StackPanel>
        </Grid>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 书源列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 统计信息 -->
                <StackPanel
                    Grid.Row="0"
                    Padding="16,8"
                    Orientation="Horizontal"
                    Spacing="16">
                    <TextBlock
                        x:Name="SourceCountText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Content="全选"
                        Click="SelectAll_Click"
                        Style="{StaticResource SubtleButtonStyle}" />
                    <Button
                        Content="取消全选"
                        Click="DeselectAll_Click"
                        Style="{StaticResource SubtleButtonStyle}" />
                    <Button
                        Content="删除选中"
                        Click="DeleteSelected_Click"
                        Foreground="Red"
                        Style="{StaticResource SubtleButtonStyle}" />
                </StackPanel>

                <!-- 书源列表 -->
                <ListView
                    x:Name="SourceList"
                    Grid.Row="1"
                    SelectionMode="Multiple"
                    IsItemClickEnabled="True"
                    ItemClick="SourceList_ItemClick"
                    ContextRequested="SourceList_ContextRequested">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    x:Name="SourceCheckBox"
                                    Grid.Column="0"
                                    IsChecked="True"
                                    Margin="0,0,8,0" />

                                <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock
                                        Text="{x:Bind}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="书源信息"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="2"
                                    OnContent="启用"
                                    OffContent="禁用"
                                    IsOn="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 详情面板 -->
            <Grid
                x:Name="DetailPanel"
                Grid.Column="1"
                Width="350"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="书源详情"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,0,0,16" />

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="12">
                        <TextBox
                            x:Name="SourceNameBox"
                            Header="书源名称"
                            PlaceholderText="输入书源名称" />
                        <TextBox
                            x:Name="SourceUrlBox"
                            Header="书源 URL"
                            PlaceholderText="https://example.com" />
                        <TextBox
                            x:Name="SearchUrlBox"
                            Header="搜索 URL"
                            PlaceholderText="搜索地址，{0} 为关键词占位符" />
                        <TextBox
                            x:Name="RuleSearchBox"
                            Header="搜索规则 (JSON)"
                            PlaceholderText="输入搜索规则 JSON"
                            AcceptsReturn="True"
                            Height="120"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="RuleTocBox"
                            Header="目录规则 (JSON)"
                            PlaceholderText="输入目录规则 JSON"
                            AcceptsReturn="True"
                            Height="120"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="RuleContentBox"
                            Header="正文规则 (JSON)"
                            PlaceholderText="输入正文规则 JSON"
                            AcceptsReturn="True"
                            Height="120"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,16,0,0">
                    <Button
                        Content="保存"
                        Click="SaveSource_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Content="取消"
                        Click="CancelEdit_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 空状态 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE8D8;"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="还没有书源"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="点击上方按钮导入书源，或从社区仓库一键获取"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
