<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyReader.Pages.PodcastPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：播客列表 -->
        <Grid
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid
                Grid.Row="0"
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="播客"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="AddPodcastButton"
                    Grid.Column="1"
                    Click="AddPodcast_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="添加" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 播客列表 -->
            <ListView
                x:Name="PodcastList"
                Grid.Row="1"
                Padding="8"
                SelectionChanged="PodcastList_SelectionChanged"
                ContextRequested="PodcastList_ContextRequested">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Spacing="4">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Text="{Binding Author}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="刷新"
                            Click="RefreshPodcast_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="删除"
                            Click="DeletePodcast_Click"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <!-- 空状态 -->
            <StackPanel
                x:Name="PodcastEmptyState"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xF096;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="还没有播客"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="点击上方按钮添加播客源"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 右侧：单集列表 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid
                Grid.Row="0"
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock
                    x:Name="EpisodeTitle"
                    Text="单集"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- 单集列表 -->
            <ListView
                x:Name="EpisodeList"
                Grid.Row="1"
                Padding="8"
                ItemClick="EpisodeList_ItemClick"
                IsItemClickEnabled="True"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="12,8" Spacing="4">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock
                                    Text="{Binding PublishDate}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="{Binding Duration}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel
                x:Name="EpisodeEmptyState"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="选择一个播客查看单集"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
