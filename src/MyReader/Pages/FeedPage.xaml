<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyReader.Pages.FeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：订阅源列表 -->
        <Grid
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid
                Grid.Row="0"
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="RSS 订阅"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="AddFeedButton"
                    Grid.Column="1"
                    Click="AddFeed_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="添加" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 订阅源列表 -->
            <ListView
                x:Name="FeedList"
                Grid.Row="1"
                Padding="8"
                SelectionChanged="FeedList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Spacing="4">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Text="{Binding Description}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel
                x:Name="FeedEmptyState"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xF098;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="还没有订阅源"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="点击上方按钮添加 RSS/Atom 源"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 右侧：文章列表 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid
                Grid.Row="0"
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock
                    x:Name="ArticleTitle"
                    Text="文章"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- 文章列表 -->
            <ListView
                x:Name="ArticleList"
                Grid.Row="1"
                Padding="8"
                ItemClick="ArticleList_ItemClick"
                IsItemClickEnabled="True"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="12,8" Spacing="4">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2" />
                            <TextBlock
                                Text="{Binding Summary}"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="3" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock
                                    Text="{Binding Author}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="{Binding PublishDate}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel
                x:Name="ArticleEmptyState"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="选择一个订阅源查看文章"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
