<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyReader.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid
            Grid.Row="0"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock
                Text="设置"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 设置内容 -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel Spacing="24" MaxWidth="600">

                <!-- 外观 -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="外观"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                Text="主题"
                                VerticalAlignment="Center"
                                MinWidth="80" />
                            <ComboBox
                                x:Name="ThemeComboBox"
                                SelectionChanged="ThemeComboBox_SelectionChanged"
                                MinWidth="150">
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                                <ComboBoxItem Content="跟随系统" Tag="Default" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 阅读设置 -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="阅读"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                Text="默认字号"
                                VerticalAlignment="Center"
                                MinWidth="80" />
                            <Slider
                                x:Name="DefaultFontSizeSlider"
                                Minimum="14"
                                Maximum="28"
                                Value="18"
                                Width="200" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                Text="默认行高"
                                VerticalAlignment="Center"
                                MinWidth="80" />
                            <Slider
                                x:Name="DefaultLineHeightSlider"
                                Minimum="24"
                                Maximum="48"
                                Value="30"
                                Width="200" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 数据管理 -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="数据管理"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                Text="数据目录"
                                VerticalAlignment="Center"
                                MinWidth="80" />
                            <TextBlock
                                x:Name="DataPathText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button
                                Content="打开"
                                Click="OpenDataFolder_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock
                                Text="数据库大小"
                                VerticalAlignment="Center"
                                MinWidth="80" />
                            <TextBlock
                                x:Name="DbSizeText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 关于 -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="关于"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Spacing="8">
                        <TextBlock Text="MyReader" FontWeight="SemiBold" />
                        <TextBlock
                            Text="版本 1.0.0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="开源 Windows 桌面阅读器"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton
                            Content="GitHub 仓库"
                            NavigateUri="https://github.com/levi440/MyReader" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
