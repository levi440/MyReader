<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyReader.Pages.ComicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Grid
            Grid.Row="0"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="漫画库"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />

            <Button
                x:Name="AddComicButton"
                Grid.Column="1"
                Click="AddComic_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock Text="添加漫画" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 漫画网格 -->
        <GridView
            x:Name="ComicGrid"
            Grid.Row="1"
            Padding="16"
            IsItemClickEnabled="True"
            ItemClick="ComicGrid_ItemClick"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Width="140"
                        Padding="4"
                        CornerRadius="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="186" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 封面 -->
                        <Border
                            Grid.Row="0"
                            CornerRadius="4"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <Image
                                Source="{Binding CoverPath}"
                                Stretch="UniformToFill" />
                        </Border>

                        <!-- 信息 -->
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                FontSize="13"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Text="{Binding Author}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="4" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>

        <!-- 空状态提示 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE8F4;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="还没有漫画"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="点击上方按钮添加 CBZ/CBR/ZIP 文件"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
