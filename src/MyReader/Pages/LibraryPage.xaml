<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyReader.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Grid
            Grid.Row="0"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="本地书架"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="RefreshButton"
                    Click="Refresh_Click"
                    Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="AddBookButton"
                    Click="AddBook_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="添加书籍" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 书籍网格 -->
        <GridView
            x:Name="BookGrid"
            Grid.Row="1"
            Padding="16"
            IsItemClickEnabled="True"
            ItemClick="BookGrid_ItemClick"
            SelectionMode="None"
            ContextRequested="BookGrid_ContextRequested">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Width="140"
                        Padding="4"
                        CornerRadius="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="186" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 封面 -->
                        <Border
                            Grid.Row="0"
                            CornerRadius="4"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <Grid>
                                <Image
                                    Source="{Binding CoverPath}"
                                    Stretch="UniformToFill" />
                                <!-- 文件类型标签 -->
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="4"
                                    Padding="4,2"
                                    CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock
                                        Text="{Binding FileType}"
                                        FontSize="10"
                                        Foreground="White"
                                        FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 进度条 -->
                        <Grid
                            Grid.Row="0"
                            VerticalAlignment="Bottom"
                            Height="3"
                            Margin="4,0,4,4"
                            CornerRadius="2">
                            <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="2" />
                            <Border
                                x:Name="ProgressBorder"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Width="{Binding Progress}" />
                        </Grid>

                        <!-- 信息 -->
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                FontSize="13"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Text="{Binding Author}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="4" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Name="OpenBookMenu"
                        Text="打开"
                        Click="OpenBook_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="DeleteBookMenu"
                        Text="删除"
                        Click="DeleteBook_Click"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </MenuFlyout>
            </GridView.ContextFlyout>
        </GridView>

        <!-- 空状态提示 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE8F1;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="还没有书籍"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="点击上方按钮添加 EPUB、PDF 或 TXT 文件"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
